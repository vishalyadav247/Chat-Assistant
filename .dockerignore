# Reinstalled by `npm ci` / regenerated by `npm run build` inside the image
node_modules
build
.cache
.react-router

# VCS
.git
.gitignore
.gitattributes

# Secrets — never bake these into an image
.env
.env.*
!.env.example

# Claude Code tooling: specs, skills, agents, design prototypes, QA sheets
.claude
.mcp.json

# Dev/ops scripts — all require `tsx`, a devDependency that
# `npm ci --omit=dev` does not install, so they cannot run here
scripts

# Local dev infrastructure
docker-compose.yml
.shopify
.shopify.lock

# Lint/format/codegen config — not used by `react-router build`
.eslintrc.cjs
.eslintignore
.prettierignore
.editorconfig
.graphqlrc.ts

# Docs
README.md
CHANGELOG.md

# OS cruft
.DS_Store

# NOTE: app/, prisma/, public/, extensions/, package*.json, tsconfig.json,
# vite.config.ts, env.d.ts and .npmrc must stay — the build needs them.
# extensions/ in particular is imported at build time by
# app/lib/widget/renderer-assets.server.ts via Vite `?raw`.
