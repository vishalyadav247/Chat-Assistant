# Copy to .env and fill in. Shopify CLI injects its own vars (SHOPIFY_API_KEY etc.) during `npm run dev`.
#
# ─────────────────────────────────────────────────────────────────────────────
# MOST OF THIS FILE IS OPTIONAL SINCE THE PLATFORM CONSOLE (spec 19).
# The operator sets these at /platform/settings instead; values are stored in
# the database (secrets encrypted) and the dashboard value WINS over the
# variable below. Env is the fallback + the way to configure a brand-new
# deployment before anyone can log in.
#
# REQUIRED IN ENV (no dashboard equivalent — the app can't boot without them):
#   DATABASE_URL, SHOPIFY_API_KEY, SHOPIFY_API_SECRET, SHOPIFY_APP_URL, SCOPES
#   (the SHOPIFY_* group is injected by the CLI in dev / set by your host in prod)
# ─────────────────────────────────────────────────────────────────────────────

# Postgres (docker-compose: npm run db:up). Port 5433 to avoid local Postgres collisions.
DATABASE_URL=postgresql://chatconvert:chatconvert@localhost:5433/chatconvert

# LLM provider (app/lib/llm). Seeding works without a key (pseudo-embeddings).
# → OPENAI_API_KEY and CHAT_MODEL are dashboard-managed (Settings / AI model).
OPENAI_API_KEY=
LLM_PROVIDER=openai
CHAT_MODEL=gpt-4o-mini
# Env only ON PURPOSE: stored vectors are pinned to 1536 dims, so switching the
# embedding model needs a re-embed migration, not a toggle.
EMBEDDING_MODEL=text-embedding-3-small

# → Dashboard: Settings → Operational flags. Env values below are fallbacks.
# Billing (spec 15): mock the Shopify Billing API for offline testing.
# BILLING_TEST_MODE=1
# Force test:true charges in production (app review / partner test stores).
# BILLING_FORCE_TEST_CHARGES=1
# Theme app-embed detection needs the read_themes scope (not requested yet).
# EMBED_STATUS_ENABLED=1

# → Dashboard: Settings → Links & listing.
# App Store listing handle (apps.shopify.com/<handle>) — activates the
# "Leave a review" link in Settings → General once the listing is live.
# SHOPIFY_APP_STORE_HANDLE=

# ── Platform admin panel (spec 19) — operator dashboard at /platform ─────────
# First-run bootstrap ONLY: while zero platform admins exist, signing in at
# /platform/login with exactly these credentials creates the first account.
# UNSET BOTH after the first login — while set, an empty admin table re-arms them.
# Canonical path: npx tsx scripts/platform-admin.ts create <email> <name> <password>
# PLATFORM_ADMIN_EMAIL=
# PLATFORM_ADMIN_PASSWORD=

# Windows only: uncomment if Prisma fails with "query_engine-windows.dll.node is not a valid Win32 application"
# PRISMA_CLIENT_ENGINE_TYPE=binary

# ── Standalone web surface (spec 18) ─────────────────────────────────────────
# → ALL dashboard-managed now (Settings → Transactional email / Links).
# Configure them here only if you prefer env, or for a fresh deployment.
# Recommended: Resend (HTTPS API; works identically from a dev tunnel and prod).
#   resend.com → Domains → add + verify your domain → API Keys → Create.
EMAIL_PROVIDER=resend                           # log (no sending; UI offers copy-link) | resend | smtp
RESEND_API_KEY=
EMAIL_FROM="ChatConvert <no-reply@yourdomain.com>"
#
# Optional — only if you can't use Resend (self-hosted SMTP / SES / Mailgun):
# EMAIL_PROVIDER=smtp  SMTP_HOST=  SMTP_PORT=587  SMTP_USER=  SMTP_PASS=  SMTP_SECURE=false
#
# Optional — all auto-configured; set only to override:
# WEB_APP_URL=https://app.example.com          # defaults to SHOPIFY_APP_URL
# VAPID_PUBLIC_KEY= / VAPID_PRIVATE_KEY=        # auto-generated once and stored in app_secrets
# VAPID_SUBJECT=mailto:support@yourdomain.com   # defaults to the EMAIL_FROM address
