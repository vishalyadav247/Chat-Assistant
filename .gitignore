node_modules

# macOS
.DS_Store

# Build output / caches
/.cache
/build
/app/build
/public/build/
/public/_dev
/app/public/build
/extensions/*/dist

# Local dev databases
/prisma/dev.sqlite
/prisma/dev.sqlite-journal
database.sqlite

# Secrets — .env.example is the only one that ships
.env
.env.*
!.env.example

# Shopify CLI files created during app dev
.shopify/
.shopify.lock
# Local dev app configs (shopify.app.dev.toml etc). shopify.app.toml is the
# production app and IS tracked; the pattern below cannot match it. Keeping dev
# configs out of the repo means production can never be confused for one.
shopify.app.*.toml

# Auto-generated by react router
.react-router/

# Claude Code tooling.
# TRACKED — how and why this app was built, and what still needs verifying:
# CLAUDE.md, PROGRESS.md, specs/, skills/, agents/.
# (QA lives in scripts/qa/ — suites and their case docs together.)
.claude/settings.local.json
# Generated QA artefact — rebuild with `npx tsx scripts/qa/make-test-matrix.ts`.
# A binary in git conflicts on every merge that touches it, and the diff is
# unreadable, so the generator is the source of truth and this is not tracked.
scripts/qa/test-matrix.xlsx
