// ChatConvert schema — Postgres + pgvector, multi-tenant (every domain table is shop-scoped).
// Vector columns are Unsupported(): created here, WRITTEN only via raw SQL (see app/lib/embeddings).
// Migration workflow: NEVER `prisma db push` — see .claude/skills/db-tenancy/SKILL.md.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

// ── Shopify session storage (template) ──────────────────────────────────────

model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?

  @@map("sessions")
}

// ── Tenant root ─────────────────────────────────────────────────────────────

model Shop {
  id            String    @id @default(cuid())
  domain        String    @unique // my-store.myshopify.com
  name          String?
  currency      String?
  timezone      String?
  plan          String    @default("free") // free | basic | pro | plus
  planStatus    String    @default("none") // none | trial | active | cancelled
  subscriptionId  String? // gid of the active AppSubscription
  billingInterval String? // monthly | yearly
  trialEndsAt     DateTime?
  usageLineItemId String? // AppSubscriptionLineItem gid for usage records
  aiEnabled     Boolean   @default(true)
  installedAt   DateTime  @default(now())
  uninstalledAt DateTime?

  @@map("shops")
}

// ── Catalog mirror (spec 02) ────────────────────────────────────────────────

model Product {
  id               String                       @id @default(cuid())
  shopId           String
  shopifyProductId String
  title            String
  description      String                       @default("")
  productType      String                       @default("")
  vendor           String                       @default("")
  tags             String[]                     @default([])
  status           String                       @default("active")
  price            Decimal                      @default(0)
  stock            Int                          @default(0)
  imageUrl         String?
  handle           String                       @default("")
  variants         Json?
  metafields       Json? // DEFINED product + variant metafields as synced (see metafields.server.ts)
  metafieldText    String                       @default("") // rendered ENABLED metafields — embedded + full-text indexed
  contentHash      String? // productEmbeddingText() hash — re-embed only on change
  learnEnabled     Boolean                      @default(true)
  embedding        Unsupported("vector(1536)")?
  searchText       Unsupported("tsvector")? // GENERATED column (see init migration)
  createdAt        DateTime                     @default(now())
  updatedAt        DateTime                     @updatedAt

  @@unique([shopId, shopifyProductId])
  @@index([shopId, price])
  @@index([shopId, stock])
  @@map("products")
}

/// Shopify metafield definitions (products + variants) mirrored per shop —
/// structured metafields only. `enabled` = merchant opted this metafield into
/// AI training (Manage metafields modal, spec 07).
model ProductMetafieldDefinition {
  id            String   @id @default(cuid())
  shopId        String
  ownerType     String   @default("product") // product | variant
  namespace     String
  key           String
  name          String
  type          String   @default("single_line_text_field")
  hasDefinition Boolean  @default(false)
  usedIn        Int      @default(0)
  enabled       Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([shopId, ownerType, namespace, key])
  @@index([shopId])
  @@map("product_metafield_definitions")
}

model Collection {
  id                  String   @id @default(cuid())
  shopId              String
  shopifyCollectionId String
  title               String
  description         String   @default("")
  conditions          String   @default("Manual")
  productCount        Int      @default(0)
  learnEnabled        Boolean  @default(false)
  updatedAt           DateTime @updatedAt

  @@unique([shopId, shopifyCollectionId])
  @@index([shopId])
  @@map("collections")
}

model Discount {
  id                String    @id @default(cuid())
  shopId            String
  shopifyDiscountId String
  title             String
  summary           String    @default("")
  status            String    @default("active")
  // Display fields for the Discounts training table (spec 07):
  // method: code | automatic; discountType: amount_off_order |
  // amount_off_products | free_shipping | bxgy; usedCount: asyncUsageCount.
  method            String    @default("code")
  discountType      String    @default("amount_off_order")
  usedCount         Int       @default(0)
  // Per-discount AI learning flag (user decision 2026-08-12: bulk actions are
  // app-only — they gate AI usage, never mutate the discount in Shopify).
  learnEnabled      Boolean   @default(true)
  startsAt          DateTime?
  endsAt            DateTime?
  updatedAt         DateTime  @updatedAt

  @@unique([shopId, shopifyDiscountId])
  @@index([shopId])
  @@map("discounts")
}

model SyncState {
  id             String    @id @default(cuid())
  shopId         String    @unique
  productSyncAt  DateTime?
  collectionSyncAt DateTime?
  discountSyncAt DateTime?
  metafieldSyncAt DateTime? // metafield definitions catalog (spec 07 Manage metafields)
  productCount   Int       @default(0)
  status         String    @default("idle") // idle | running | error
  errorMessage   String?
  cappedAt       Int?

  @@map("sync_states")
}

// ── Knowledge / RAG (spec 04) ───────────────────────────────────────────────

model DataSource {
  id           String    @id @default(cuid())
  shopId       String
  type         String // url | manual | csv | file | pages | faq
  name         String
  url          String?
  crawlScope   String? // page | linked | sitemap
  reCrawlWeekly Boolean  @default(false)
  status       String    @default("pending") // pending | active | inactive | error | suggested
  chunkCount   Int       @default(0)
  lastSyncedAt DateTime?
  metadata     Json?
  createdAt    DateTime  @default(now())

  @@index([shopId, type])
  @@map("data_sources")
}

model Knowledge {
  id           String                       @id @default(cuid())
  shopId       String
  dataSourceId String?
  topic        String
  body         String
  embedding    Unsupported("vector(1536)")?
  createdAt    DateTime                     @default(now())

  @@index([shopId])
  @@index([dataSourceId])
  @@map("knowledge")
}

// ── FAQs (spec 07) ──────────────────────────────────────────────────────────

model FaqCategory {
  id        String  @id @default(cuid())
  shopId    String
  name      String
  icon      String  @default("📄")
  position  Int     @default(0)
  status    String  @default("published") // published | draft
  featured  Boolean @default(false)
  isDefault Boolean @default(false)

  @@index([shopId])
  @@map("faq_categories")
}

model Faq {
  id         String  @id @default(cuid())
  shopId     String
  categoryId String?
  question   String
  answerHtml String  @default("")
  status     String  @default("draft") // published | draft
  featured   Boolean @default(false)
  position   Int     @default(0)

  @@index([shopId, status])
  @@map("faqs")
}

// ── Curated answers (spec 09) ───────────────────────────────────────────────

model CuratedAnswer {
  id            String                       @id @default(cuid())
  shopId        String
  question      String
  synonyms      String[]                     @default([])
  productIds    String[]                     @default([]) // shopify product ids
  talkingPoints String                       @default("")
  status        String                       @default("draft") // draft | published
  priority      String                       @default("normal") // low | normal | high
  servedCount   Int                          @default(0)
  stockIssue    Boolean                      @default(false) // dead-stock pick flag
  embedding     Unsupported("vector(1536)")?
  createdAt     DateTime                     @default(now())
  updatedAt     DateTime                     @updatedAt

  @@index([shopId, status])
  @@map("curated_answers")
}

// ── Recommendations (spec 08) ───────────────────────────────────────────────

model Recommendation {
  id               String                       @id @default(cuid())
  shopId           String
  title            String
  triggerQuestions String[]                     @default([])
  productIds       String[]                     @default([])
  status           String                       @default("active")
  embedding        Unsupported("vector(1536)")?
  updatedAt        DateTime                     @updatedAt

  @@index([shopId])
  @@map("recommendations")
}

model CrossSellPair {
  id           String   @id @default(cuid())
  shopId       String
  productId    String // shopify product id (the anchor)
  companionIds String[] @default([])
  status       String   @default("active")
  updatedAt    DateTime @updatedAt

  @@unique([shopId, productId])
  @@map("cross_sell_pairs")
}

model UnresolvedQuestion {
  id             String   @id @default(cuid())
  shopId         String
  question       String
  conversationId String?
  reason         String   @default("fell_back") // fell_back | low_confidence | repeated
  count          Int      @default(1)
  status         String   @default("pending") // pending | handled | dismissed
  createdAt      DateTime @default(now())

  @@index([shopId, status])
  @@map("unresolved_questions")
}

model CustomRecommendation {
  id            String   @id @default(cuid())
  shopId        String
  name          String
  searchTerms   String[] @default([])
  productIds    String[] @default([])
  collectionIds String[] @default([])
  status        String   @default("inactive")
  updatedAt     DateTime @updatedAt

  @@index([shopId])
  @@map("custom_recommendations")
}

// ── Per-shop AI config (specs 03/08) ────────────────────────────────────────

model Persona {
  id                 String   @id @default(cuid())
  shopId             String   @unique
  role               String   @default("")
  communicationStyle String   @default("friendly")
  brandVoice         String   @default("")
  behaviours         String   @default("")
  guidelines         String[] @default([])
  avoid              String[] @default([])
  scope              String   @default("")
  offTopicMessage    String   @default("")
  defaultLanguage    String   @default("en")
  languages          String[] @default(["en"])
  autoDetectLanguage Boolean  @default(false)
  welcomeMessage     String   @default("")

  @@map("personas")
}

model Guardrails {
  id                      String   @id @default(cuid())
  shopId                  String   @unique
  answerOnlyFromKnowledge Boolean  @default(true)
  bannedTopics            String[] @default([])
  fallbackMessage         String   @default("")
  minMeaningScore         Float    @default(0.30)
  curatedMatchThreshold   Float    @default(0.80)
  curatedBorderline       Float    @default(0.65)
  bannedMatchThreshold    Float    @default(0.35)

  @@map("guardrails")
}

model HandoverConfig {
  id     String @id @default(cuid())
  shopId String @unique
  config Json // triggers + destination + nested options (zod-validated, spec 08)

  @@map("handover_configs")
}

model WidgetSettings {
  id       String @id @default(cuid())
  shopId   String @unique
  settings Json // full widget config (zod-validated, spec 06)

  @@map("widget_settings")
}

model ShopSettings {
  id       String @id @default(cuid())
  shopId   String @unique
  settings Json // store info, theme, inbox, availability, survey, tracking, retention (spec 16)

  @@map("shop_settings")
}

// ── Conversations (specs 03/10) ─────────────────────────────────────────────

model Conversation {
  id            String    @id @default(cuid())
  shopId        String
  sessionId     String
  contactId     String?
  mode          String    @default("ai") // ai | human
  status        String    @default("open") // open | resolved
  outcome       String?
  starred       Boolean   @default(false)
  blocked       Boolean   @default(false)
  unread        Boolean   @default(true)
  handover      Boolean   @default(false)
  assigneeId    String?
  channel       String    @default("store")
  isTest        Boolean   @default(false)
  summary       String? // rolling history summary cache
  summaryMessageCount Int @default(0) // messages covered when summary was last refreshed
  meteredAt     DateTime? // last usage-meter tick (session metering, spec 15)
  rating        Int?
  pageContext   Json?
  startedAt     DateTime  @default(now())
  endedAt       DateTime?
  lastMessageAt DateTime  @default(now())

  @@index([shopId, status, lastMessageAt])
  @@index([shopId, sessionId])
  // Inbox list: shopId + isTest, newest first (the single most-run query in the
  // app). The status index above cannot serve it — status sits between the two
  // constrained columns, so the planner fell back to a full scan + top-N sort.
  @@index([shopId, isTest, lastMessageAt])
  // Analytics rollup / dashboard KPIs / conversation CSV all window on startedAt.
  @@index([shopId, startedAt])
  // Contacts list + contact detail count conversations per contact.
  @@index([shopId, contactId])
  @@map("conversations")
}

model Message {
  id             String    @id @default(cuid())
  conversationId String
  shopId         String
  role           String // in | out | sys
  author         String    @default("ai") // ai | agent | shopper | system
  content        String
  productCards   Json?
  sourceLayer    String? // banned | curated | router | buy | question | chat | handover
  intent         Json?
  seenAt         DateTime?
  createdAt      DateTime  @default(now())

  @@index([conversationId, createdAt])
  // Supersedes the old bare @@index([shopId]) — same leading column, and it is
  // the difference between a parallel seq scan of every message and an index
  // range scan for the day-window (analytics rollup) and newest-first
  // (top questions) reads.
  @@index([shopId, createdAt])
  @@map("messages")
}

model Contact {
  id                String   @id @default(cuid())
  shopId            String
  sessionId         String?
  name              String?
  email             String?
  phone             String?
  type              String   @default("anonymous") // customer | lead | anonymous
  channel           String   @default("store")
  location          String?
  marketingOptIn    Boolean  @default(false)
  shopifyCustomerId String?
  createdAt         DateTime @default(now())

  @@index([shopId, email])
  @@index([shopId, type])
  @@map("contacts")
}

// ── Analytics & campaigns (specs 12/13/14) ──────────────────────────────────

model AnalyticsEvent {
  id         String   @id @default(cuid())
  shopId     String
  type       String
  payload    Json?
  occurredAt DateTime @default(now())

  @@index([shopId, type, occurredAt])
  @@map("analytics_events")
}

model MetricsDaily {
  id       String   @id @default(cuid())
  shopId   String
  date     DateTime @db.Date
  counters Json

  @@unique([shopId, date])
  @@map("metrics_daily")
}

model Campaign {
  id           String   @id @default(cuid())
  shopId       String
  name         String
  templateType String
  status       String   @default("inactive")
  priority     Int      @default(0)
  settings     Json?
  views        Int      @default(0)
  clicks       Int      @default(0)
  atcs         Int      @default(0)
  revenue      Decimal  @default(0)
  orders       Int      @default(0)
  updatedAt    DateTime @updatedAt

  @@index([shopId, priority])
  @@map("campaigns")
}

// ── Billing (spec 15) ───────────────────────────────────────────────────────

model PlanUsage {
  id                String   @id @default(cuid())
  shopId            String
  periodStart       DateTime @db.Date
  conversationCount Int      @default(0)
  overageCount      Int      @default(0)

  @@unique([shopId, periodStart])
  @@map("plan_usage")
}

// Per-shop LLM token consumption, rolled up daily (spec 19 · platform usage
// analytics). One row per shop × UTC day × model × purpose. Written
// fire-and-forget from the LLM seam — never blocks a shopper's chat.
model LlmUsageDaily {
  id               String   @id @default(cuid())
  shopId           String
  date             DateTime @db.Date
  model            String
  purpose          String // router | reply | summary | moderation | embedding
  calls            Int      @default(0)
  promptTokens     Int      @default(0)
  cachedTokens     Int      @default(0) // subset of promptTokens, billed cheaper
  completionTokens Int      @default(0)
  updatedAt        DateTime @updatedAt

  @@unique([shopId, date, model, purpose])
  @@index([date])
  @@map("llm_usage_daily")
}

// ── Compliance (spec 17) ────────────────────────────────────────────────────

model DataRequest {
  id            String    @id @default(cuid())
  shopId        String
  customerEmail String
  status        String    @default("pending") // pending | ready | completed
  exportPath    String?
  requestedAt   DateTime  @default(now())
  dueAt         DateTime
  completedAt   DateTime?

  @@index([shopId])
  @@map("data_requests")
}

model RedactLog {
  id          String    @id @default(cuid())
  shopId      String
  type        String // customer | shop
  receivedAt  DateTime  @default(now())
  completedAt DateTime?

  @@index([shopId])
  @@map("redact_logs")
}

// ── Team & standalone web access (spec 18) ──────────────────────────────────
// Team members are merchant staff who may log into ChatConvert outside the
// Shopify admin (web surface). Owner row is created lazily from the admin
// handoff; `assigneeId` on conversations keeps the literal "owner" key for the
// owner role and the member id for everyone else.

model TeamMember {
  id           String    @id @default(cuid())
  shopId       String
  email        String
  name         String
  role         String    @default("agent") // owner | admin | agent
  status       String    @default("invited") // invited | active | disabled
  passwordHash String?
  notifyPrefs  Json?
  failedLogins Int       @default(0)
  lockedUntil  DateTime?
  invitedAt    DateTime  @default(now())
  joinedAt     DateTime?
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([shopId, email])
  @@index([shopId])
  @@index([email])
  @@map("team_members")
}

// Opaque-token sessions + one-time tokens (handoff / invite / reset). The raw
// token lives only in the cookie / link; the row stores sha256(token).
model TeamSession {
  id         String   @id @default(cuid())
  tokenHash  String   @unique
  shopId     String
  memberId   String
  kind       String   @default("session") // session | handoff | invite | reset
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  userAgent  String?

  @@index([shopId, memberId])
  @@index([expiresAt])
  @@map("team_sessions")
}

model PushSubscription {
  id         String    @id @default(cuid())
  shopId     String
  memberId   String
  endpoint   String    @unique
  p256dh     String
  auth       String
  userAgent  String?
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  failedAt   DateTime?

  @@index([shopId, memberId])
  @@map("push_subscriptions")
}

// App-level (not shop-scoped) generated secrets, e.g. auto-provisioned VAPID
// keys for Web Push when the env vars are absent. Env always overrides.
model AppSecret {
  key       String   @id
  value     String
  createdAt DateTime @default(now())

  @@map("app_secrets")
}

// ── Platform admin panel (spec 19) — operator accounts, cross-tenant BY DESIGN ──
// These tables belong to the company running the app, not to any shop.

model PlatformAdmin {
  id           String            @id @default(cuid())
  email        String            @unique
  name         String
  passwordHash String
  failedLogins Int               @default(0) // per-account lockout (parity with TeamMember)
  lockedUntil  DateTime?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  sessions     PlatformSession[]

  @@map("platform_admins")
}

model PlatformSession {
  id         String        @id @default(cuid())
  tokenHash  String        @unique // sha256 of the raw cookie token
  adminId    String
  admin      PlatformAdmin @relation(fields: [adminId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  lastSeenAt DateTime      @default(now())
  userAgent  String?
  createdAt  DateTime      @default(now())

  @@index([adminId])
  @@index([expiresAt])
  @@map("platform_sessions")
}

// ── Logging & observability (spec 21) ───────────────────────────────────────
// Operator-only error/warning log, surfaced cross-tenant at /platform/logs.
// Errors and warnings ONLY (never a row per request) and purged after 14 days
// by the nightly retention job — those two rules are what keep this table in
// Postgres instead of a paid log service. `shopId` is nullable by design: the
// scheduler and boot path have no shop context, and attributing their failures
// to an arbitrary shop would be worse than leaving them global.
model AppLog {
  id         String   @id @default(cuid())
  level      String // error | warn
  event      String // stable snake_case code, e.g. curated_revalidate_error
  shopId     String? // null = system-wide
  message    String // truncated to 1000 chars by the write seam
  context    Json? // denylist-sanitised, capped at 2 KB — never shopper PII
  occurredAt DateTime @default(now())

  @@index([occurredAt])
  @@index([shopId, occurredAt])
  @@index([level, event, occurredAt])
  @@map("app_logs")
}

// ── Promo codes (spec 15 · discount coupons) — operator-owned, cross-tenant BY DESIGN ──
// Codes are created in the platform console and handed to merchants out of band
// (mail/chat). Redemptions are per shop and feed the Shopify Billing API
// `discount` on the recurring line of appSubscriptionCreate.

model PromoCode {
  id                String            @id @default(cuid())
  code              String            @unique // stored upper-case, no spaces
  description       String            @default("") // internal note ("Black Friday 2026")
  kind              String // percent | fixed
  value             Decimal // percent: 1–100, fixed: USD off per billing interval
  durationIntervals Int? // billing intervals the discount lasts; null = forever
  plans             String[]          @default([]) // paid plan ids; empty = any paid plan
  intervals         String[]          @default([]) // monthly | yearly; empty = both
  maxRedemptions    Int? // null = unlimited
  expiresAt         DateTime?
  active            Boolean           @default(true)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  redemptions       PromoRedemption[]

  @@map("promo_codes")
}

model PromoRedemption {
  id             String    @id @default(cuid())
  shopId         String
  promoCodeId    String
  promoCode      PromoCode @relation(fields: [promoCodeId], references: [id], onDelete: Cascade)
  subscriptionId String? // AppSubscription gid the discount was attached to
  plan           String
  interval       String
  // pending (awaiting approval) | redeemed (live) | released (subscription ended)
  status         String    @default("pending")
  createdAt      DateTime  @default(now())
  redeemedAt     DateTime?

  // One row per shop per code: the row IS the shop's relationship with the
  // code, and it follows the shop across plan changes (see promo-codes.server).
  // It also makes the maxRedemptions reservation atomic — a concurrent second
  // attempt by the same shop can never create a second row.
  @@unique([shopId, promoCodeId])
  @@index([promoCodeId, status])
  @@index([subscriptionId])
  @@map("promo_redemptions")
}
